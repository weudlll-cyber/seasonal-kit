{
  "name": "@seasonal/kit",
  "version": "0.10.0",
  "description": "Shared shell, UI and platform parts of the Seasonal games.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": "github:weudlll-cyber/seasonal-kit",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/dev": {
      "types": "./dist/react/dev/index.d.ts",
      "default": "./dist/react/dev/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./motion.css": "./css/motion.css",
    "./call.css": "./css/call.css",
    "./fit.css": "./css/fit.css",
    "./dock.css": "./css/dock.css",
    "./shell.css": "./css/shell.css",
    "./frames.css": "./css/frames.css",
    "./bar.css": "./css/bar.css",
    "./header.css": "./css/header.css"
  },
  "files": [
    "browser",
    "css",
    "dist",
    "fonts"
  ],
  "peerDependencies": {
    "react": "19.3.1",
    "vite": "8.3.4"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:test": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
