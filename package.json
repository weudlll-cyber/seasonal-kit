{
  "name": "@seasonal/kit",
  "version": "0.27.0",
  "description": "Shared shell, UI and platform parts of the Seasonal games.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": "github:weudlll-cyber/seasonal-kit",
  "type": "module",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/dev": {
      "types": "./dist/react/dev/index.d.ts",
      "default": "./dist/react/dev/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "default": "./dist/devtools/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./motion.css": "./css/motion.css",
    "./call.css": "./css/call.css",
    "./fit.css": "./css/fit.css",
    "./dock.css": "./css/dock.css",
    "./shell.css": "./css/shell.css",
    "./frames.css": "./css/frames.css",
    "./bar.css": "./css/bar.css",
    "./header.css": "./css/header.css",
    "./steps.css": "./css/steps.css",
    "./seasons.css": "./css/seasons.css",
    "./seasons/*.svg": "./seasons/*.svg"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@playwright/test": "^1.64.1",
    "react": "^19.3.1",
    "vite": "^8.3.4"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "showcase": "vite --config showcase/vite.config.ts",
    "showcase:build": "vite build --config showcase/vite.config.ts",
    "showcase:test": "playwright test",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.11.0",
    "jsdom": "31.0.1",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "files": [
    "browser",
    "css",
    "dist",
    "fonts",
    "ops/backup.sh",
    "ops/lib/backup-core.sh",
    "ops/lib/backup-restore.sh",
    "ops/lib/website-route.sh",
    "ops/pull-backups.sh",
    "ops/pull-backups.ps1",
    "seasons"
  ]
}
