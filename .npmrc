# @file   .npmrc
# @brief  npm-level settings, mirroring pnpm-workspace.yaml (as in Mini Games, plus no scripts).
#
# Responsibility: the same behaviour if npm runs by mistake: refuse unsupported Node versions,
#                 pin exact versions, run no install script. pnpm reads pnpm-workspace.yaml.
engine-strict=true
save-exact=true
ignore-scripts=true
