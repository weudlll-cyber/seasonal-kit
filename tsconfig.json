/**
 * @file   tsconfig.json
 * @brief  Strict TypeScript for everything in the kit: source, tests, scripts and configs.
 *
 * Responsibility: Mini Games' compiler checks (its tsconfig.base.json); NodeNext so the
 *                 compiled dist/ runs in Node (Vitest in a game) and in Vite alike; the DOM
 *                 library for the browser parts. Type-checks only; tsconfig.build.json emits.
 * Used by:        pnpm typecheck, ESLint's typed rules, tsconfig.build.json
 */
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src", "scripts", "tests", "browser", "*.config.js", "*.config.ts"]
}
