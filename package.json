{
  "name": "@seasonal/kit",
  "version": "0.2.0",
  "description": "Shared shell, UI and platform parts of the Seasonal games.",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "repository": "github:weudlll-cyber/seasonal-kit",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./tokens.css": "./css/tokens.css",
    "./fonts.css": "./css/fonts.css",
    "./motion.css": "./css/motion.css"
  },
  "files": [
    "browser",
    "css",
    "dist",
    "fonts"
  ],
  "peerDependencies": {
    "vite": "8.3.4"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.3",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
