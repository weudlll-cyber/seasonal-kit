# @file   .gitignore
# @brief  Files git leaves out. dist/ is NOT ignored: it is committed at every tag, because games
#         install the kit from git without running any build (docs/DELIVERY.md).
node_modules/
coverage/
*.log
.claude/settings.local.json
# The showcase's build and its screens: local only, never committed (DECISIONS K16,
# docs/SHOWCASE.md); Playwright's own output.
showcase/dist/
showcase/screens/
test-results/
playwright-report/
